  {
    "index": 21,
    "language": "python",
    "text": "class SimpleModel(nn.Module):\n\n    def __init__(self):\n        super().__init__()\n\n        self.fc1 = nn.Linear(4, 8)\n        self.relu = nn.ReLU()\n        self.fc2 = nn.Linear(8, 2)\n\n    def forward(self, x):\n\n        x = self.fc1(x)\n        x = self.relu(x)\n        x = self.fc2(x)\n\n        return x",
    "sha256": "d8590352f88ea2697668da7101a1f1e3bbc117d2c8729c1b7ffe1469ba8d9097"
  },
  {
    "index": 22,
