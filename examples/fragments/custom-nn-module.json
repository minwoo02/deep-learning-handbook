    "sha256": "1c5271fa4f58a1c75af48240fb6413bcc1f41aaac9e28de529a030b4e906f17a"
  },
  {
    "index": 33,
    "language": "text",
    "text": "layers.0.weight torch.Size([8, 4])\nlayers.0.bias torch.Size([8])\nlayers.1.weight torch.Size([2, 8])\nlayers.1.bias torch.Size([2])",
