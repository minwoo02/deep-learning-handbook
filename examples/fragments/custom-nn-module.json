    "text": "class BufferExample(nn.Module):\n\n    def __init__(self):\n\n        super().__init__()\n\n        self.register_buffer(\n            \"scale\",\n            torch.tensor(2.0)\n        )\n\n    def forward(self, x):\n\n        return x * self.scale",
