  {
    "index": 103,
    "language": "python",
    "text": "class MyModel(nn.Module):\n\n    def __init__(self):\n\n        super().__init__()\n\n        self.linear = nn.Linear(10, 1)\n\n    def forward(self, x):\n\n        print(\"forward called\")\n\n        return self.linear(x)",
    "sha256": "2cf52110390f4578a5021018420a8b0a44bbc73b27bf609f727bc9a88abf0f3c"
  },
  {
    "index": 104,
    "language": "python",
    "text": "model = MyModel()",
    "sha256": "44b88f119501e0f524d62818fecd1c9befafd640691fea9a420408d7c75374c9"
  },
  {
    "index": 105,
    "language": "python",
    "text": "x = torch.randn(1, 10)",
    "sha256": "d490067d87003aa06eab4bfbd92ea46bc626594a1c629063a90647940b0623ef"
