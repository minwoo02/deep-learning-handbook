  {
    "index": 61,
    "language": "python",
    "text": "class HiddenBlock(nn.Module):\n\n    def __init__(self):\n\n        super().__init__()\n\n        self.layers = nn.Sequential(\n            nn.Linear(4, 8),\n            nn.ReLU()\n        )\n\n    def forward(self, x):\n\n        return self.layers(x)\n\n\nclass NestedANN(nn.Module):\n\n    def __init__(self):\n\n        super().__init__()\n\n        self.block = HiddenBlock()\n        self.output = nn.Linear(8, 2)\n\n    def forward(self, x):\n\n        x = self.block(x)\n        x = self.output(x)\n\n        return x",
    "sha256": "3df709c2368da33a4918bdd8c0d914571901f1e120fe92a64ca0910ee71c731d"
  },
  {
    "index": 62,
