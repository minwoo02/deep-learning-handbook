  },
  {
    "index": 107,
    "language": "text",
    "text": "model(x)\n   │\n   ▼\nnn.Module.__call__()\n   │\n   ├── Forward Pre-Hook 처리\n   │\n   ▼\nforward(x)\n   │\n   ▼\nForward Hook 처리\n   │\n   ▼\nOutput 반환",
    "sha256": "a823197b9d5fb06e52d09d61333d41829cd8b6fdcd753b31a0782eec5aa12932"
  },
  {
    "index": 108,
    "language": "python",
    "text": "output = model(x)",
    "sha256": "d1d620559071cc978188501cea3b14a1defb4adb53ec819caf31a1ecbe25782e"
  },
  {
    "index": 109,
    "language": "python",
    "text": "output = model.forward(x)",
    "sha256": "659c2bfb17ff4638603299ccd9aad3afd417433b79f9d8e53281156abf7f9966"
  },
  {
    "index": 110,
    "language": "python",
    "text": "output = model(x)",
    "sha256": "d1d620559071cc978188501cea3b14a1defb4adb53ec819caf31a1ecbe25782e"
  },
  {
    "index": 111,
    "language": "python",
    "text": "model = nn.Sequential(\n    nn.Linear(4, 8),\n    nn.ReLU(),\n    nn.Linear(8, 2)\n)",
    "sha256": "a36706194b626fc4384ae673955003359d551b30ad93eb75864df323ec6ca06e"
  },
  {
    "index": 112,
    "language": "python",
    "text": "def print_output(module, inputs, output):\n\n    print(\"Module:\", module)\n\n    print(\"Output Shape:\", output.shape)",
    "sha256": "41245d2d458beab837c579faa8064c078109ea7f78790a185b5bded9dc5dcb7c"
  },
  {
    "index": 113,
    "language": "python",
    "text": "handle = model[0].register_forward_hook(\n    print_output\n)",
    "sha256": "6a2fe05bf7944c6f7671aa147c5de9c0d298f82651c6543aa2a69dc8f64f1c04"
  },
  {
