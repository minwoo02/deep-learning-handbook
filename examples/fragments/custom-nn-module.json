    "language": "python",
    "text": "def initialize_weights(module):\n\n    if isinstance(module, nn.Linear):\n\n        nn.init.xavier_uniform_(module.weight)\n\n        if module.bias is not None:\n            nn.init.zeros_(module.bias)",
