  },
  {
    "index": 6,
    "language": "python",
    "text": "class CustomModel(nn.Module):",
    "sha256": "37ab34396ae49dd9ed58b72c0a5e7144a115e4b97781fe0887cda7fd6e45583b"
  },
  {
    "index": 7,
    "language": "text",
    "text": "torch.nn.Module\n       │\n       │ Inheritance\n       ▼\n   CustomModel",
    "sha256": "55edef5ff010db910ffb56697f2efbedcbff9e0ef77c8903776d6db9ea90817d"
  },
  {
    "index": 8,
    "language": "python",
    "text": "def __init__(self):\n    super().__init__()",
    "sha256": "54c5324b9695f08a9ce427f53015be5371355782b87dc603aedeb20ea0bec5f7"
  },
  {
    "index": 9,
    "language": "python",
    "text": "class CustomModel(nn.Module):\n\n    def __init__(self):\n        super().__init__()\n\n        self.linear1 = nn.Linear(4, 16)\n        self.relu = nn.ReLU()\n        self.linear2 = nn.Linear(16, 2)",
    "sha256": "7e7442fb689f4718cfc58170677430abfcbd2e6a6021662e7ab72f562c15be98"
  },
  {
    "index": 10,
    "language": "text",
    "text": "CustomModel\n│\n├── linear1 : Linear(4, 16)\n│\n├── relu    : ReLU()\n│\n└── linear2 : Linear(16, 2)",
    "sha256": "6b4e508f9d1b4d7e68c294a66ed9072d82daee14c5f730398232ac37e5519d47"
  },
  {
    "index": 11,
    "language": "python",
    "text": "def __init__(self):\n    super().__init__()  # 부모 클래스 초기화\n\n    self.linear = nn.Linear(4, 2)",
    "sha256": "b94f40e3aa8761f0d3603e69040e8523fe22174b650460e5abf918427bec438f"
  },
  {
    "index": 12,
    "language": "python",
    "text": "def forward(self, x):\n\n    x = self.linear1(x)\n\n    x = self.relu(x)\n\n    x = self.linear2(x)\n\n    return x",
    "sha256": "b1b9f86bd84fbd50fd143cdd02b8be39174d3d7d72dd78b132f176fd04106464"
  },
  {
    "index": 13,
    "language": "text",
    "text": "Input Tensor\n     │\n     ▼\nLinear Layer\n     │\n     ▼\nReLU\n     │\n     ▼\nLinear Layer\n     │\n     ▼\nOutput Tensor",
    "sha256": "73e8b4af924ccc5247ebad8ff60c5eb4e7ab19a515450e985e365aaabcbbb98b"
  },
  {
    "index": 14,
    "language": "text",
    "text": "Input Layer\n    │\n    │ 4 Features\n    ▼\nLinear(4, 32)\n    │\n    ▼\n   ReLU\n    │\n    ▼\nLinear(32, 32)\n    │\n    ▼\n   ReLU\n    │\n    ▼\nLinear(32, 2)\n    │\n    ▼\nOutput Layer",
    "sha256": "8bbcc01906560f976c8bad6ac6d1ca9d33c7b2667153fd7465f77e27195bec08"
  },
  {
    "index": 15,
    "language": "python",
    "text": "import torch\nimport torch.nn as nn\n\n\nclass CustomMLP(nn.Module):\n\n    def __init__(self, input_dim, output_dim):\n\n        super().__init__()\n\n        # 첫 번째 은닉층\n        self.linear1 = nn.Linear(input_dim, 32)\n        self.relu1 = nn.ReLU()\n\n        # 두 번째 은닉층\n        self.linear2 = nn.Linear(32, 32)\n        self.relu2 = nn.ReLU()\n\n        # 출력층\n        self.linear3 = nn.Linear(32, output_dim)\n\n    def forward(self, x):\n\n        x = self.linear1(x)\n        x = self.relu1(x)\n\n        x = self.linear2(x)\n        x = self.relu2(x)\n\n        x = self.linear3(x)\n\n        return x",
    "sha256": "991017281ccf77935f920184d5f0f9a27d047a1715a9f27de09e699dcdc2dfd8"
  },
  {
    "index": 16,
    "language": "python",
    "text": "model = CustomMLP(\n    input_dim=4,\n    output_dim=2\n)\n\nprint(model)",
    "sha256": "d8b49ca9c298859a0411e0f914b54614774483a1014d56b100c90d5c3411b41c"
  },
  {
    "index": 17,
    "language": "text",
    "text": "CustomMLP(\n  (linear1): Linear(in_features=4, out_features=32, bias=True)\n  (relu1): ReLU()\n  (linear2): Linear(in_features=32, out_features=32, bias=True)\n  (relu2): ReLU()\n  (linear3): Linear(in_features=32, out_features=2, bias=True)\n)",
    "sha256": "20eb6f8d87fda8b3c8a9926183ae4649f81ebd2da1005f099187b6de5ce09500"
  },
  {
    "index": 18,
    "language": "python",
