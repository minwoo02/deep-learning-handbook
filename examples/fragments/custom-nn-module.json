  },
  {
    "index": 26,
    "language": "python",
    "text": "class DynamicMLP(nn.Module):\n\n    def __init__(self, input_dim, output_dim):\n\n        super().__init__()\n\n        self.add_module(\n            \"fc1\",\n            nn.Linear(input_dim, 32)\n        )\n\n        self.add_module(\n            \"relu1\",\n            nn.ReLU()\n        )\n\n        self.add_module(\n            \"fc2\",\n            nn.Linear(32, output_dim)\n        )\n\n    def forward(self, x):\n\n        x = self.fc1(x)\n        x = self.relu1(x)\n        x = self.fc2(x)\n\n        return x",
    "sha256": "87e725a885ed007831b2355c520a3d6bd24836ce2202d2454cc6723575f7b96e"
  },
  {
    "index": 27,
    "language": "python",
    "text": "model = DynamicMLP(4, 2)\n\nprint(model)",
    "sha256": "83df5e6fa5adb25a8da17fe2e46cd2ad76fef9a6c19542dca1f8e774e7ad8917"
  },
  {
    "index": 28,
    "language": "python",
    "text": "class WrongModel(nn.Module):\n\n    def __init__(self):\n\n        super().__init__()\n\n        self.layers = [\n            nn.Linear(4, 8),\n            nn.Linear(8, 2)\n        ]\n\n    def forward(self, x):\n\n        for layer in self.layers:\n            x = layer(x)\n\n        return x",
    "sha256": "237d0d3d06206decb732219ba18262d13917e6cdf663bab8dc1f930f26178a1f"
  },
  {
    "index": 29,
    "language": "python",
    "text": "model = WrongModel()\n\nprint(list(model.parameters()))",
    "sha256": "5523107d8ee76f9f90d7bdebf6e557c1a7e12fd7a7dcd290559ab29f70b780e2"
  },
