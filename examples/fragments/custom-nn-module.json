    "sha256": "e3715f89aaf31aa43be753698591a4ce7de237f3186b5caa76f2dbb31dd50461"
  },
  {
    "index": 115,
    "language": "text",
    "text": "torch.Size([3, 8])",
    "sha256": "237b546e1ff59de849610c24d63573a48cecdb0af81f2a164a1666805b580881"
  },
  {
    "index": 116,
    "language": "python",
    "text": "handle.remove()",
    "sha256": "0b9cc7b8d3375e33b500f83bc05ab4762e63d0e628bab234f9aefb53460158ad"
  },
  {
    "index": 117,
    "language": "text",
    "text": "Custom Model 정의\n        │\n        ▼\nclass CustomModel(nn.Module)\n        │\n        ▼\n__init__()\n        │\n        ├── Layer 등록\n        ├── Parameter 등록\n        └── Buffer 등록\n        │\n        ▼\nModel Instance 생성\n        │\n        ▼\nmodel.to(device)\n        │\n        ▼\nOptimizer 생성\n        │\n        ▼\nInput Tensor\n        │\n        ▼\nmodel(x)\n        │\n        ▼\nnn.Module.__call__()\n        │\n        ▼\nforward(x)\n        │\n        ▼\nOutput Tensor\n        │\n        ▼\nLoss 계산\n        │\n        ▼\nBackward Propagation\n        │\n        ▼\nOptimizer Step\n        │\n        ▼\nParameter Update",
    "sha256": "e2f5c4a21cc2d93dbd4b6659b15857bf2967047397480b8d2b36df10ba605191"
  },
  {
    "index": 118,
    "language": "python",
    "text": "import torch\nimport torch.nn as nn\n\n# 모델 생성\nmodel = SimpleANN()\n\n# Optimizer\noptimizer = torch.optim.Adam(\n    model.parameters(),\n    lr=0.001\n)\n\n# Loss Function\ncriterion = nn.MSELoss()\n\n# 입력 데이터\nx = torch.randn(10, 4)\n\n# Target 데이터\ntarget = torch.randn(10, 2)\n\n# 학습 모드\nmodel.train()\n\n# Gradient 초기화\noptimizer.zero_grad()\n\n# Forward Propagation\noutput = model(x)\n\n# Loss 계산\nloss = criterion(output, target)\n\n# Backward Propagation\nloss.backward()\n\n# Parameter Update\noptimizer.step()\n\nprint(\"Loss:\", loss.item())",
    "sha256": "344cb6749558db0c0390490b39b92193c44bfa0f22e1fbdf01b848e4322367bd"
  },
  {
    "index": 119,
    "language": "python",
    "text": "model = SimpleANN()",
    "sha256": "1cab5df7cfd23663e11c5e651b5f24f98501ec459d1443e2ec97272edc21e54f"
  },
  {
    "index": 120,
    "language": "python",
    "text": "optimizer = torch.optim.Adam(\n    model.parameters(),\n    lr=0.001\n)",
    "sha256": "e6f1da253365e017430f10784682e8f34c1f737b52fce1881a051c9942bc1283"
  },
  {
    "index": 121,
    "language": "python",
    "text": "output = model(x)",
    "sha256": "d1d620559071cc978188501cea3b14a1defb4adb53ec819caf31a1ecbe25782e"
  },
  {
    "index": 122,
    "language": "python",
    "text": "loss = criterion(output, target)",
    "sha256": "ed276d52dcb3d1809d60703206626eb73e6b6b480f2980e0472ffee082f36894"
  },
  {
    "index": 123,
