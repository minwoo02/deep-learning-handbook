    "index": 41,
    "language": "python",
    "text": "class CustomLinear(nn.Module):\n\n    def __init__(self):\n\n        super().__init__()\n\n        self.weight = nn.Parameter(\n            torch.randn(2, 4)\n        )\n\n        self.bias = nn.Parameter(\n            torch.zeros(2)\n        )\n\n    def forward(self, x):\n\n        return x @ self.weight.T + self.bias",
