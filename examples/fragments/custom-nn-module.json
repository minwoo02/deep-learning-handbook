    "sha256": "a4843212175087fe021efc3731551ab8fc30fd8134d1ff5986250d3b16addca8"
  },
  {
    "index": 63,
    "language": "text",
    "text": "NestedANN\n│\n├── HiddenBlock\n│   │\n│   └── Sequential\n│       ├── Linear(4, 8)\n│       └── ReLU\n│\n└── Linear(8, 2)",
    "sha256": "10a9c66411dbebeeec6cced37b6bc3f2a7ff3eb8f5d83fa16e0f5334d4ec8312"
