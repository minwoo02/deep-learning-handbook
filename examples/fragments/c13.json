  },
  {
    "index": 75,
    "language": "text",
    "text": "Input(4)\n   │\n   ▼\nLinear(4, 16)\n   │\n   ▼\nBatchNorm1d(16)\n   │\n   ▼\nReLU\n   │\n   ▼\nLinear(16, 16)\n   │\n   ▼\nBatchNorm1d(16)\n   │\n   ▼\nReLU\n   │\n   ▼\nLinear(16, 3)\n   │\n   ▼\nOutput Logits",
    "sha256": "bcf081583e0a5e47d772b29fb2ed474d55dc6b2212098d4f1c606864021cc46e"
  },
  {
    "index": 76,
    "language": "python",
    "text": "import torch\nimport torch.nn as nn\n\n\nclass IrisANN_BN(nn.Module):\n\n    def __init__(self):\n\n        super().__init__()\n\n        self.net = nn.Sequential(\n\n            nn.Linear(4, 16),\n\n            nn.BatchNorm1d(16),\n\n            nn.ReLU(),\n\n            nn.Linear(16, 16),\n\n            nn.BatchNorm1d(16),\n\n            nn.ReLU(),\n\n            nn.Linear(16, 3)\n        )\n\n    def forward(self, x):\n\n        return self.net(x)",
    "sha256": "e9c6dd086fac8148be5edb8999cca2ffe918c1f2714819cc6bdc626e5261ff73"
  },
  {
    "index": 77,
    "language": "python",
    "text": "model = IrisANN_BN()\n\nprint(model)",
    "sha256": "8faf77c359b0ad12be6838a9b5b3308afb490254b07045aee02e2d0153d160bb"
  },
  {
    "index": 78,
    "language": "python",
    "text": "criterion = nn.CrossEntropyLoss()\n\noptimizer = torch.optim.Adam(\n    model.parameters(),\n    lr=0.001\n)\n\nmodel.train()\n\nfor X, y in train_loader:\n\n    optimizer.zero_grad()\n\n    logits = model(X)\n\n    loss = criterion(\n        logits,\n        y\n    )\n\n    loss.backward()\n\n    optimizer.step()",
    "sha256": "3840b225daf97405da7a4ba35b50c45b2a788fd167b3007315598a5d15598663"
  },
  {
    "index": 79,
    "language": "python",
    "text": "train_loader = DataLoader(\n    train_dataset,\n    batch_size=16,\n    shuffle=True,\n    drop_last=True\n)",
    "sha256": "89baf4e0d09fca23658511899ea6e8ceaa896f774850e1e14d655de642cf39fb"
  },
