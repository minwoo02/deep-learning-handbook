  },
  {
    "index": 71,
    "language": "python",
    "text": "model = SimpleCNN()",
    "sha256": "4ffc7cd89477481bba96686563a69d98acb230e834219a29cafe6f8ef2e9efc8"
  },
  {
    "index": 72,
    "language": "python",
    "text": "x = torch.randn(\n    8,\n    1,\n    28,\n    28\n)",
