[
  {
    "index": 0,
    "language": "text",
    "text": "Input\n  │\n  ▼\nLinear Transformation\n  │\n  ▼\nBatch Normalization\n  │\n  ▼\nActivation Function\n  │\n  ▼\nNext Layer",
    "sha256": "1b6a44365d5b8453b08934c8a2167f6db9a3a84f6cff443b8619b70d1d1f9886"
  },
  {
    "index": 1,
    "language": "text",
    "text": "Input\n  │\n  ▼\nLayer 1\n  │\n  ▼\nLayer 2\n  │\n  ▼\nLayer 3\n  │\n  ▼\nLayer 4\n  │\n  ▼\nOutput",
    "sha256": "d3a57e2080d3b336c886218d06e79322f6aa3832d1815541ab0d4be914bd5e30"
  },
  {
    "index": 2,
    "language": "text",
    "text": "Input\n  │\n  ▼\nLayer 1\n  │\n  │ Parameter Update\n  ▼\nActivation Distribution 변화\n  │\n  ▼\nLayer 2\n  │\n  ▼\nLayer 3",
    "sha256": "712f79d4f56580873cdf5e7bac22bbeaa18c0960bb5c921c6417e1d11b705f30"
  },
  {
    "index": 3,
    "language": "text",
    "text": "torch.Size([16, 4])",
    "sha256": "566bd6a5310bc68a09378941b20e2f3f4685a9c4eaa4bdd1fcf78fa62eadef78"
  },
  {
    "index": 4,
    "language": "python",
    "text": "batch_mean = X.mean(dim=0)",
    "sha256": "010b341635968c7abe2ed2c2eaf3bf613f2c6fa418b5c04ab49658706fcdcb6c"
  },
  {
    "index": 5,
    "language": "python",
    "text": "batch_var = X.var(\n    dim=0,\n    correction=0\n)",
    "sha256": "0ac83378c48d49f244643648475120d7b0fb30d97297dfe7e459f26259d96f8c"
  },
  {
    "index": 6,
    "language": "python",
    "text": "X_normalized = (\n    X - batch_mean\n) / torch.sqrt(\n    batch_var + 1e-5\n)",
    "sha256": "afd29788d568a635488c3fd0113e6925f1b5597d90a18c1a862cd1637db3e5b2"
  },
  {
    "index": 7,
    "language": "text",
    "text": "Batch Normalization\n        │\n        ▼\nInternal Covariate Shift 감소\n        │\n        ▼\nTraining Stability 향상",
    "sha256": "c76242f5ef28d191a2fac4ba5f7d1d58cdaac0c8e3e3ab907e8764def060df68"
  },
  {
    "index": 8,
    "language": "text",
    "text": "Batch Normalization\n        │\n        ▼\nOptimization Landscape의\nSmoothness 개선\n        │\n        ▼\nGradient의 안정적인 변화\n        │\n        ▼\nTraining Stability 향상",
    "sha256": "b28ccdd6227b89ec5edaac03e1fee2f3c24ce7e6ddf1adac0bfd2d154835cd7b"
  },
  {
    "index": 9,
    "language": "python",
    "text": "bn.weight",
    "sha256": "c19eff91b22d813f0627383951941801a9b08771d7335c338709ac955b2e9523"
  },
  {
    "index": 10,
    "language": "python",
    "text": "bn.bias",
    "sha256": "80f971856b77cc1be0d690fa38b099761897001d4fbc585055b68a13e9053b32"
  },
  {
    "index": 11,
    "language": "text",
    "text": "weight = 1\nbias   = 0",
    "sha256": "0cdbacd3ac4c626c7a5f582557815bb7b1b3f8d7537bedd0a7120441ede1a22c"
  },
  {
    "index": 12,
    "language": "python",
    "text": "bn.running_mean",
    "sha256": "b291e0ece4eba672de3d6f2377c1f2c211343d3744061aac206590249bf7e45d"
  },
  {
    "index": 13,
    "language": "python",
    "text": "bn.running_var",
    "sha256": "95edf613f5b61fe8e5f7a03cc88c5c2c837adf1986311809c348f4d425d4986e"
  },
  {
    "index": 14,
    "language": "text",
    "text": "weight\nbias\nrunning_mean\nrunning_var\nnum_batches_tracked",
    "sha256": "5ab28e2ffc39b687895e0010fcd50540a7840076520f010e6bfe9279ffc1ee40"
  },
  {
    "index": 15,
    "language": "text",
    "text": "[16, 32, 28, 28]",
    "sha256": "cf15e229956fa426a81f76a45857709c888cc44fd822b6ce7b391b39aab3091f"
  },
  {
    "index": 16,
    "language": "text",
    "text": "Input Feature Map\n        │\n        ▼\n      Conv2d\n        │\n        ▼\n   BatchNorm2d\n        │\n        ▼\n       ReLU\n        │\n        ▼\n Next Convolution",
    "sha256": "81bb76f52436c4159cffe3912c8c9620549f66fd4a0a2d38c85d0c293c29daec"
  },
  {
    "index": 17,
    "language": "python",
    "text": "import torch.nn as nn\n\nblock = nn.Sequential(\n    nn.Conv2d(\n        in_channels=3,\n        out_channels=32,\n        kernel_size=3,\n        padding=1,\n        bias=False\n    ),\n\n    nn.BatchNorm2d(32),\n\n    nn.ReLU()\n)",
    "sha256": "479cdf7f333c69544fc925d77779f4f78ee928ecca7f499a2acef40ac9c8c1e0"
  },
  {
    "index": 18,
    "language": "python",
    "text": "nn.BatchNorm2d(32)",
    "sha256": "16192a2f6b87d766bca31161a24adf4d7f6134d52bb921f1c125ad1e5f02a8a6"
  },
  {
    "index": 19,
    "language": "python",
    "text": "nn.Conv2d(\n    3,\n    32,\n    kernel_size=3,\n    bias=False\n)",
    "sha256": "e2674d6445d672a3a98aa7f9e20be3758f30c311655b47d20fb62a351e5399de"
  },
  {
    "index": 20,
    "language": "text",
    "text": "           Features\n          F1  F2  F3\n\nSample 1   x   x   x\nSample 2   x   x   x\nSample 3   x   x   x\nSample 4   x   x   x\n\n       ↓\n각 Feature의 열 방향으로\nMean / Variance 계산",
    "sha256": "2c11fd8f296c7c45ab335e3c55d6a786605033bfd4dc559c49eb8c3eee8f8198"
  },
  {
    "index": 21,
    "language": "text",
    "text": "           Features\n          F1  F2  F3\n\nSample 1   x───x───x\nSample 2   x───x───x\nSample 3   x───x───x\nSample 4   x───x───x\n\n       ↓\n각 Sample의 행 방향으로\nMean / Variance 계산",
    "sha256": "d132d7ee5c837e0a72f4e4f516e02173d2d3b61225bc06707c69016fba35931a"
  },
  {
    "index": 22,
    "language": "text",
    "text": "Weight Initialization\n        │\n        ▼\nInitial Parameters\n        │\n        ▼\nForward Propagation\n        │\n        ▼\nBatch Normalization\n        │\n        ▼\nLoss Calculation\n        │\n        ▼\nBackpropagation\n        │\n        ▼\nParameter Update",
    "sha256": "4f7e843426f882d40bacbe90e9996c5768d53b0402def87da3f2cacf93006958"
  },
  {
    "index": 23,
    "language": "python",
    "text": "import torch\n\ntorch.nn.utils.clip_grad_norm_(\n    model.parameters(),\n    max_norm=1.0\n)",
    "sha256": "cecefb9d18ec40404c52dcc898310cf1bca5f108db40f40b3ce6dce8a4cfb32c"
  },
  {
    "index": 24,
    "language": "python",
    "text": "optimizer.zero_grad()\n\nloss.backward()\n\ntorch.nn.utils.clip_grad_norm_(\n    model.parameters(),\n    max_norm=1.0\n)\n\noptimizer.step()",
    "sha256": "f9ed794add01179cf14281752de81d75f10b886a9b48ba598dfefa8d2ebb5246"
  },
  {
    "index": 25,
    "language": "python",
    "text": "import torch\nimport torch.nn as nn",
    "sha256": "53426ca58cb1889f2c3c96e096a3d433e5aa669fa6374efdb932a179174ce2ac"
  },
  {
    "index": 26,
    "language": "python",
    "text": "bn = nn.BatchNorm1d(3)",
    "sha256": "d6d654eadd9709f6944b49406a31bab51d7726fe0b9d526bc2a4eeb07b1e14d4"
  },
  {
    "index": 27,
    "language": "python",
    "text": "torch.manual_seed(42)\n\nx = torch.randn(8, 3)\n\nprint(x.shape)",
    "sha256": "0369008def5f1265ee88e3a98bd51ff68211299a71f355950b71fba6b78a5441"
  },
  {
    "index": 28,
    "language": "text",
    "text": "torch.Size([8, 3])",
    "sha256": "7a1d7c9383c8a54f0dd725d5b731e912ea2a2000da55173ae087ae8654d78acb"
  },
  {
    "index": 29,
    "language": "python",
    "text": "bn.train()\n\ny = bn(x)\n\nprint(y.shape)",
    "sha256": "b1de1b1f5d0f272b6382bcc2454020929fb44830f48dfff93d9f2425551a987a"
  },
  {
    "index": 30,
    "language": "text",
    "text": "torch.Size([8, 3])",
    "sha256": "7a1d7c9383c8a54f0dd725d5b731e912ea2a2000da55173ae087ae8654d78acb"
  },
  {
    "index": 31,
    "language": "python",
    "text": "import torch\n\nx = torch.tensor([\n    [1.0, 10.0, 100.0],\n    [2.0, 20.0, 200.0],\n    [3.0, 30.0, 300.0],\n    [4.0, 40.0, 400.0]\n])",
    "sha256": "79b9bd6a35491d08206c1457ada6e0bfc8d8f1d22ff7d6cb1c56a8e5fb54fd76"
  },
  {
    "index": 32,
    "language": "python",
    "text": "print(x.shape)",
    "sha256": "f4730632f652fdab1617a7259e77a3c23d84d5833d47d0bb13801a846c8b5275"
  },
  {
    "index": 33,
    "language": "text",
    "text": "torch.Size([4, 3])",
    "sha256": "4f6920a17963917a82dd2fa7241512d48a96c820881cfa5a590d85ef80dd94d5"
  },
  {
    "index": 34,
    "language": "python",
    "text": "mean = x.mean(dim=0)\n\nprint(mean)",
    "sha256": "858b998bb321ce652c9b4b88d8108aa9d79321e6d14454bb75170dd9106a993d"
  },
  {
    "index": 35,
    "language": "text",
    "text": "tensor([  2.5000,  25.0000, 250.0000])",
    "sha256": "3f04fc6511fd52e17b7cb269b5c447b00d20d439e6a405502d4c4a1530ce1c0b"
  },
  {
    "index": 36,
    "language": "python",
    "text": "var = x.var(\n    dim=0,\n    correction=0\n)\n\nprint(var)",
    "sha256": "ca3e49f0a7fc66a99e86f590e8817c80b7090662b54e04e1ac1de48accb531c7"
  },
  {
    "index": 37,
    "language": "text",
    "text": "tensor([   1.2500,  125.0000, 12500.0000])",
    "sha256": "0be6996cf1b8fdce99d364452a21df1711b9ce24b79ef115ced6eace44a00623"
  },
  {
    "index": 38,
    "language": "python",
    "text": "eps = 1e-5\n\nx_normalized = (\n    x - mean\n) / torch.sqrt(\n    var + eps\n)\n\nprint(x_normalized)",
    "sha256": "7a2a369a01d46d900e6ef1a1914cf8e55ce2d3b06f9a8784aae7b24b30d0fe31"
  },
  {
    "index": 39,
    "language": "python",
    "text": "print(\n    \"Mean:\",\n    x_normalized.mean(dim=0)\n)\n\nprint(\n    \"Variance:\",\n    x_normalized.var(\n        dim=0,\n        correction=0\n    )\n)",
    "sha256": "674445123f06a2cc4a01df5f0ba485c5f840833598d34ad878558c5c2945e5d4"
  },
  {
    "index": 40,
    "language": "python",
    "text": "import torch.nn as nn\n\nbn = nn.BatchNorm1d(\n    num_features=3,\n    affine=False,\n    track_running_stats=False\n)\n\nbn.train()\n\ny = bn(x)\n\nprint(y)",
    "sha256": "0bc5bf4dce4c214a93f1407564f97e8880c242afffa277efaf28af1e1eb0397b"
  },
  {
    "index": 41,
    "language": "python",
    "text": "affine=False",
    "sha256": "01d01f45f354c33e479d43ea48281360df1548a8d5d93d3568c38ae359b193b6"
  },
  {
    "index": 42,
    "language": "python",
    "text": "track_running_stats=False",
    "sha256": "6bfa4e7378c717673541fb45de028f712cda507b8cd1aaeb4f5a65c91a5e5b79"
  },
  {
    "index": 43,
    "language": "python",
    "text": "print(\n    torch.allclose(\n        x_normalized,\n        y,\n        atol=1e-5\n    )\n)",
    "sha256": "6d45c2a88bbd138ec978533329ef42e076d03816e49cd0411397d868094beae6"
  },
  {
    "index": 44,
    "language": "python",
    "text": "import torch\nimport torch.nn as nn\n\nbn = nn.BatchNorm1d(4)\n\nprint(\"Gamma:\")\nprint(bn.weight)\n\nprint(\"Beta:\")\nprint(bn.bias)",
    "sha256": "f3a0f415d6ad097cd23dc011421126fa9198d8cd1390c52205abdfb5766019db"
  },
  {
    "index": 45,
    "language": "text",
    "text": "Gamma:\ntensor([1., 1., 1., 1.])\n\nBeta:\ntensor([0., 0., 0., 0.])",
    "sha256": "2cd12198b1bd36747164ff9ceb3dd5a31d9ac143b3acc84066038ecfab1b8ff0"
  },
  {
    "index": 46,
    "language": "python",
    "text": "bn.weight",
    "sha256": "c19eff91b22d813f0627383951941801a9b08771d7335c338709ac955b2e9523"
  },
  {
    "index": 47,
    "language": "python",
    "text": "bn.bias",
    "sha256": "80f971856b77cc1be0d690fa38b099761897001d4fbc585055b68a13e9053b32"
  },
  {
    "index": 48,
    "language": "python",
    "text": "for name, param in bn.named_parameters():\n\n    print(\n        name,\n        param.shape\n    )",
    "sha256": "5e60e943ed90da3544adf02a09034b513740589c28bb07d922b5c9e5dbdd7aec"
  },
  {
    "index": 49,
    "language": "text",
    "text": "weight torch.Size([4])\nbias torch.Size([4])",
    "sha256": "2654fcc5723d1bac7e299a48c18812efc90b29fc8a21bc1f681b1246b61375c7"
  },
  {
    "index": 50,
    "language": "python",
    "text": "bn = nn.BatchNorm1d(4)\n\nfor name, buffer in bn.named_buffers():\n\n    print(\n        name,\n        buffer\n    )",
    "sha256": "89b58379aed0c322bbb5c7682d8231c3b49d42cba7561a7bfcee17211b13179c"
  },
  {
    "index": 51,
    "language": "text",
    "text": "running_mean tensor([0., 0., 0., 0.])\n\nrunning_var tensor([1., 1., 1., 1.])\n\nnum_batches_tracked tensor(0)",
    "sha256": "207ae0a0dddccb0c476042ad4d90b6294a7a397d9699eb2f1b27e5701f65d6f3"
  },
  {
    "index": 52,
    "language": "python",
    "text": "torch.manual_seed(42)\n\nx = torch.randn(16, 4) * 3 + 5",
    "sha256": "70db75b123edc4b1b9d592c573b6db34e84e5d4c8c85a29d5c8bed8cfaa5a588"
  },
  {
    "index": 53,
    "language": "python",
    "text": "bn.train()",
    "sha256": "57c212eb393ac33bc781fe821a03fd62146962138628b69178e971db01050e0b"
  },
  {
    "index": 54,
    "language": "python",
    "text": "y = bn(x)",
    "sha256": "0a211697a8f3d14077fb22f6fbf07267646e6203600a387e8aac22e8b679ad3f"
  },
  {
    "index": 55,
    "language": "python",
    "text": "print(\n    \"Running Mean:\",\n    bn.running_mean\n)\n\nprint(\n    \"Running Variance:\",\n    bn.running_var\n)",
    "sha256": "837ae79cb28225d91b120243085ac274a8d65f5283bbb72b27d8f4b0b4460812"
  },
  {
    "index": 56,
    "language": "python",
    "text": "import torch\nimport torch.nn as nn\n\ntorch.manual_seed(42)\n\nbn = nn.BatchNorm1d(3)\n\nx_train = torch.randn(32, 3) * 2 + 4",
    "sha256": "0fdd668550b76bf4b4dfec4f02010a65213fad8508fc162c83fbd06999b1bc6d"
  },
  {
    "index": 57,
    "language": "python",
    "text": "bn.train()",
    "sha256": "57c212eb393ac33bc781fe821a03fd62146962138628b69178e971db01050e0b"
  },
  {
    "index": 58,
    "language": "python",
    "text": "train_output = bn(x_train)",
    "sha256": "87f59b3de9df9c5b1a72095fa741f05eac5c148a1ee2f469087277d03212a9b8"
  },
  {
    "index": 59,
    "language": "python",
    "text": "bn.eval()",
    "sha256": "a32e5822a0b1d08fa22d5d9be27797ecc92aa1bf9c24a4bc2552c6fae2d25a7d"
  },
  {
    "index": 60,
    "language": "python",
    "text": "x_test = torch.randn(8, 3) * 2 + 4",
    "sha256": "d8cbc1838ff9deb91052bf7c5c59f1486f7110499de90f5704ce87b978b386e9"
  },
  {
    "index": 61,
    "language": "python",
    "text": "with torch.no_grad():\n\n    test_output = bn(x_test)",
    "sha256": "50939d68e5018d812098a6234d061b7827c10667ef4fbb02a92f78f32e41323f"
  },
  {
    "index": 62,
    "language": "python",
    "text": "bn.eval()\n\nwith torch.no_grad():\n\n    output_eval = bn(x_test)\n\n\nbn.train()\n\nwith torch.no_grad():\n\n    output_train = bn(x_test)\n\n\nprint(\n    torch.allclose(\n        output_eval,\n        output_train\n    )\n)",
    "sha256": "9399d6190305cf581b0400a21575dd586b544282c92449de2f673e802d6a4a9d"
  },
  {
    "index": 63,
    "language": "python",
    "text": "model.eval()\n\nwith torch.inference_mode():\n\n    predictions = model(x)",
    "sha256": "9c8a2f732163eaf2a63899684f5e7202ceaa744d0d0ee9a9b76a0480bbe255f7"
  },
  {
    "index": 64,
    "language": "python",
    "text": "import torch\nimport torch.nn as nn\n\nx = torch.randn(\n    8,\n    16,\n    32,\n    32\n)",
    "sha256": "d3174c97c6decd61df224f2d4ad191bcfbcdf8133ca70cdc43cdf49920912473"
  },
  {
    "index": 65,
    "language": "text",
    "text": "[8, 16, 32, 32]",
    "sha256": "e621b6eec7bb805d638e90d4a0695ee07bd62e9c804675d2c1383597e92322a4"
  },
  {
    "index": 66,
    "language": "python",
    "text": "bn = nn.BatchNorm2d(16)",
    "sha256": "16f866d179d7d40f264227dde43c710896dffd80afc07e15d908b506ba0d8252"
  },
  {
    "index": 67,
    "language": "python",
    "text": "y = bn(x)\n\nprint(y.shape)",
    "sha256": "017d39b9bc1aafdcb933e533fcadb06451a50ed1a739f6648f2a7c1d7c664bdb"
  },
  {
    "index": 68,
    "language": "text",
    "text": "torch.Size([8, 16, 32, 32])",
    "sha256": "e674151e9c8dceecb0878690f38fa3f600bce4775ba57ec1195cb20b3d72b626"
  },
  {
    "index": 69,
    "language": "python",
    "text": "import torch\nimport torch.nn as nn\n\n\nclass SimpleCNN(nn.Module):\n\n    def __init__(self):\n\n        super().__init__()\n\n        self.features = nn.Sequential(\n\n            nn.Conv2d(\n                1,\n                16,\n                kernel_size=3,\n                padding=1,\n                bias=False\n            ),\n\n            nn.BatchNorm2d(16),\n\n            nn.ReLU(),\n\n            nn.MaxPool2d(2),\n\n            nn.Conv2d(\n                16,\n                32,\n                kernel_size=3,\n                padding=1,\n                bias=False\n            ),\n\n            nn.BatchNorm2d(32),\n\n            nn.ReLU(),\n\n            nn.AdaptiveAvgPool2d(1)\n        )\n\n        self.classifier = nn.Linear(\n            32,\n            10\n        )\n\n    def forward(self, x):\n\n        x = self.features(x)\n\n        x = torch.flatten(\n            x,\n            start_dim=1\n        )\n\n        x = self.classifier(x)\n\n        return x",
    "sha256": "cc1c55d00289b86e011f32a03d5448e82c44a156ea8c54a84a38d67984fc704a"
  },
  {
    "index": 70,
    "language": "text",
    "text": "Input\n  │\n  ▼\nConv2d\n  │\n  ▼\nBatchNorm2d\n  │\n  ▼\nReLU\n  │\n  ▼\nMaxPool2d\n  │\n  ▼\nConv2d\n  │\n  ▼\nBatchNorm2d\n  │\n  ▼\nReLU\n  │\n  ▼\nAdaptiveAvgPool2d\n  │\n  ▼\nFlatten\n  │\n  ▼\nLinear\n  │\n  ▼\nOutput",
